  "decisions": [
    {
      "id": "D1",
      "text": "Film według szkicu D: oś A (prasa kontra prawda) z wplecionym B (pościg Hamera), opowieść wydłużona do ok. 18 minut. Reżyser 19.11.2026: „Robimy A, ale wplatamy gdzieś te B, wydłużając opowieść”, potem „Tak, zatwierdzam D”.",
      "at": "2026-11-19",
      "by": "reżyser"
    },
    {
      "id": "D2",
      "text": "Ton: lekki humor jako ironia i suchy lektor; z ofiar się nie żartuje, każda ofiara ma imię, śmierć w teatrze cieni bez krwi; od Grapevine ton poważny (reżyser 18.11.2026: „lekko humorystycznie”).",
      "at": "2026-11-18",
      "by": "reżyser"
    },
    {
      "id": "D3",
      "text": "Film tylko po angielsku na kanał Paper Theatre; napisy w kadrze po angielsku; dla Polaków polski tytuł, opis i ewentualnie ścieżka lektora.",
      "at": "2026-11-18",
      "by": "reżyser"
    },
    {
      "id": "D4",
      "text": "Sceneria lat 30. w USA rysowana od nowa (preria, Ford V8, stacje, drukarnia, lasy Luizjany) — bez krajobrazu Chin i Japonii (zasada sceneria-na-film).",
      "at": "2026-11-19",
      "by": "reżyser"
    },
    {
      "id": "D5",
      "text": "Fakty z relacji wtórnych mają w kwestii zastrzeżenie: „reportedly”, „local historians say”, „according to local accounts”; wiersz Bonnie tylko parafrazowany; list do Forda jako niepewny.",
      "at": "2026-11-19",
      "by": "Claude"
    }
  ]
}
